APP_ENV=production
# Deixe vazio se front e API forem no mesmo domínio. Em local com Vite: http://localhost:5173
APP_ORIGIN=
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
# gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=local-dev-change-me-use-bin2hex-random-bytes-32
# Asaas: produção https://api.asaas.com/v3 | sandbox https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Geocodificação (Nominatim público: máx. 1 req/s; em produção use provedor OSM ou instância própria)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_UA=LevaJa/1.0 (contato@seudominio.com)

# --- Docker local (docker compose): as variáveis já vêm do docker-compose.yml ---
# DB_HOST=db  DB_NAME=levaja  DB_USER=levaja  DB_PASS=levaja
